Local patch: Canon EOS R6 Mark III (LibRaw pull request #745)
==============================================================

Source:   https://github.com/LibRaw/LibRaw/pull/745 (3 commits by
          JuanPabloZambrano, opened 2025-12-28, closed UNMERGED 2026-03-06)
Applies:  LibRaw 0.22.2, from pictureInfo/ndk/Libraw/jni/src with `patch -p1`

The Changelog.txt hunk of the pull request is left out, nothing builds it.

diff --git a/internal/libraw_cameraids.h b/internal/libraw_cameraids.h
index 653d283..295374b 100644
--- a/internal/libraw_cameraids.h
+++ b/internal/libraw_cameraids.h
@@ -100,6 +100,7 @@ it under the terms of the one of two licenses as you choose:
 #define CanonID_EOS_R1            (0x80000000ULL + 0x495ULL)
 #define CanonID_EOS_R5_Mark_II    (0x80000000ULL + 0x496ULL)
 #define CanonID_EOS_R100          (0x80000000ULL + 0x498ULL)
+#define CanonID_EOS_R6m3          (0x80000000ULL + 0x518ULL)
 
 // CanonID_EOS_D2000C after Canon's TIFF2CR2 convertor:
 #define CanonID_EOS_D2000C        (0x80000000ULL + 0x520ULL)
diff --git a/src/metadata/canon.cpp b/src/metadata/canon.cpp
index 5def57d..4f79262 100644
--- a/src/metadata/canon.cpp
+++ b/src/metadata/canon.cpp
@@ -118,6 +118,7 @@ void LibRaw::setCanonBodyFeatures(unsigned long long id)
            || (id == CanonID_EOS_R5_C)
            || (id == CanonID_EOS_R6)
            || (id == CanonID_EOS_R6m2)
+           || (id == CanonID_EOS_R6m3)
            || (id == CanonID_EOS_R8)
           )
   {
@@ -1308,7 +1309,7 @@ void LibRaw::parseCanonMakernotes(unsigned tag, unsigned type, unsigned len, uns
       break;
 
     case 3973: // R3; ColorDataSubVer: 34
-    case 3778: // R6 Mark II, R7, R8, R10, R50; ColorDataSubVer: 48
+    case 3778: // R6 Mark II, R6 Mark III, R7, R8, R10, R50; ColorDataSubVer: 48, 66
       imCanon.ColorDataVer = 11;
       AsShot_Auto_MeasuredWB(0x0069);
 
@@ -1316,9 +1317,18 @@ void LibRaw::parseCanonMakernotes(unsigned tag, unsigned type, unsigned len, uns
       Canon_WBpresets(2, 12);
       fseek(ifp, save1 + ((0x0069+0x00c3) << 1), SEEK_SET);
       Canon_WBCTpresets(0);
+
       offsetChannelBlackLevel2 = save1 + ((0x0069+0x0102) << 1);
       offsetChannelBlackLevel  = save1 + ((0x0069+0x0213) << 1);
-      offsetWhiteLevels        = save1 + ((0x0069+0x0217) << 1);
+
+      if (imCanon.ColorDataSubVer == 66) // R6 Mark III
+      {
+        offsetWhiteLevels = save1 + ((0x0069+0x022b) << 1);
+      }
+      else // R6 Mark II, R7, R8, R10, R50; ColorDataSubVer: 48
+      {
+        offsetWhiteLevels = save1 + ((0x0069+0x0217) << 1);
+      }
       break;
 
     case 4528: // R1, R5 Mark II; ColorDataSubVer: 64
